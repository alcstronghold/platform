{
  "name": "@alcstronghold/domain",
  "version": "0.1.0",
  "packageManager": "bun@1.3.8",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./entities": {
      "types": "./src/entities/index.ts",
      "import": "./src/entities/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "import": "./src/ports/index.ts"
    },
    "./use-cases": {
      "types": "./src/use-cases/index.ts",
      "import": "./src/use-cases/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "zod": "4.3.6"
  }
}
