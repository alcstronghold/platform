# Directus Import - Environment Variables
# ========================================
#
# SETUP:
# 1. Copy this file to .env:        cp .env.example .env
# 2. Fill in your values below
# 3. Encrypt the file:              bun run env:encrypt
# 4. Commit .env (now encrypted)
# 5. Keep .env.keys PRIVATE (it's in .gitignore)
#
# OTHER DEVS:
# 1. Get .env.keys from secure channel (1Password, etc.)
# 2. Place it in this folder
# 3. Run: bun run env:decrypt (optional, dotenvx decrypts on-the-fly)
#
# ========================================

# Directus connection
DIRECTUS_URL="http://backend.alcstronghold.local"
DIRECTUS_TOKEN="your-static-token-here"

# Development only: trust self-signed certificates (mkcert)
NODE_TLS_REJECT_UNAUTHORIZED="0"

# Alternative: use email/password instead of token
# DIRECTUS_EMAIL="admin@example.com"
# DIRECTUS_PASSWORD="your-password"
