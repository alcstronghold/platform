# =============================================================================
# ALC Stronghold - Docker Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_USER=directus
DB_PASSWORD=change_this_password
DB_DATABASE=directus

# =============================================================================
# Directus
# =============================================================================
# Generate a secret with: openssl rand -base64 32
DIRECTUS_SECRET=your-super-secret-key-here
DIRECTUS_PORT=8055

# Admin credentials (only used on first run)
ADMIN_EMAIL=alcstronghold@alcstronghold.com
ADMIN_PASSWORD=change_this_password

# Public URL (change for production)
PUBLIC_URL=http://localhost:8055

# Development settings
EXTENSIONS_AUTO_RELOAD=true
