# =============================================================================
# ALC Stronghold - Docker Environment Variables (LOCAL DEV)
# =============================================================================

# =============================================================================
# COMMON
# =============================================================================
COMMON_PATH=c:\Docker\Applications

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_USER=directus
DB_PASSWORD=directus_dev
DB_DATABASE=directus

# =============================================================================
# Directus
# =============================================================================
DIRECTUS_SECRET=pMz66nCClaUZnM68knocW9SFoWFYy-gt
DIRECTUS_PORT=8055

# Admin credentials (only used on first run)
ADMIN_EMAIL=alcstronghold@alcstronghold.com
ADMIN_PASSWORD=Admin123!

# Public URL (change for production)
PUBLIC_URL=https://backend.alcstronghold.local

# Development settings
EXTENSIONS_AUTO_RELOAD=true

# Session cookies configuration (shared auth between apps)
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=lax
REFRESH_TOKEN_COOKIE_DOMAIN=.alcstronghold.local
