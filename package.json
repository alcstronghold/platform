{
  "name": "@alcstronghold/platform",
  "version": "0.1.0",
  "packageManager": "bun@1.3.7",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "check": "moon check --all",
    "build": "moon run :build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "moon run :test",
    "version": "bun scripts/version.ts",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:major": "bun scripts/version.ts major",
    "lint:sonar": "sonar --define sonar.host.url=https://sonarqube.devtools.local --define sonar.token=sqp_31ff0131f312c76ea2aef362487e2f8c1637ac4b --define sonar.projectKey=alc-stronghold-platform --define sonar.scanner.skipJreProvisioning=true"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@eslint/js": "9.39.2",
    "@types/bun": "1.3.6",
    "@types/node": "25.0.10",
    "angular-eslint": "21.1.0",
    "bun-types": "1.3.7",
    "eslint": "9.39.2",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
