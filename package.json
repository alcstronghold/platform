{
  "name": "@alcstronghold/platform",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "check": "moon check --all",
    "build": "moon run :build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "moon run :test",
    "version": "bun scripts/version.ts",
    "version:patch": "bun scripts/version.ts patch",
    "version:minor": "bun scripts/version.ts minor",
    "version:major": "bun scripts/version.ts major"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.2",
    "@eslint/js": "^9.39.2",
    "bun-types": "^1.3.5",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.1"
  }
}
