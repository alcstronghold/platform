/* To learn more about the TypeScript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "../../packages/directus-client/src/**/*.ts",
    "../../packages/domain/src/**/*.ts",
    "../../packages/infrastructure/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "../../packages/**/*.spec.ts"
  ]
}
