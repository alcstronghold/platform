---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CounterComponent } from '../features/counter/components/counter.component';
---

<BaseLayout title="Inicio">
  <main class="min-h-screen flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-2xl">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">ALC Stronghold</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
        Plataforma de ocio alternativo: juegos de mesa, rol en vivo, RPGs de mesa y juegos de cartas coleccionables.
      </p>

      <!-- Angular Island: Counter Component -->
      <div class="mb-8">
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Angular Island (client:visible)</p>
        <CounterComponent client:visible />
      </div>

      <!-- Flowbite Button -->
      <button
        type="button"
        class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">
        Explorar Partidas
      </button>

      <!-- Flowbite Badge -->
      <div class="mt-8">
        <span
          class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-green-900 dark:text-green-300">
          Tailwind, Flowbite y Angular Islands funcionando
        </span>
      </div>
    </div>
  </main>
</BaseLayout>
