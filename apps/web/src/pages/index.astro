---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio">
  <main class="min-h-screen flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-2xl">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">ALC Stronghold</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
        Plataforma de ocio alternativo: juegos de mesa, rol en vivo, RPGs de mesa y juegos de cartas coleccionables.
      </p>

      <!-- Flowbite Badge -->
      <div class="mt-8">
        <span
          class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm dark:bg-green-900 dark:text-green-300">
          Tailwind y Flowbite funcionando
        </span>
      </div>
    </div>
  </main>
</BaseLayout>
