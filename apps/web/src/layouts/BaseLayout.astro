---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | ALC Stronghold</title>
  </head>
  <body
    class="bg-gray-50 dark:bg-gray-900 font-[var(--font-family-regular)]"
    style="font-feature-settings: var(--font-features-regular);">
    <slot />
    <script>
      import 'flowbite';
    </script>
  </body>
</html>
