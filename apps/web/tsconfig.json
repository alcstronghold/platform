{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": [
      "node"
    ],
    "paths": {
      "@astro-stronghold/layouts/*": [
        "./src/layouts/*"
      ],
      "@astro-stronghold/pages/*": [
        "./src/pages/*"
      ],
      "@astro-stronghold/components/*": [
        "./src/components/*"
      ]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  },
  "references": [
    {
      "path": "../../packages/directus-client"
    },
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/infrastructure"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
